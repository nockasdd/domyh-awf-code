{
  "name": "DOMYH Awesome Code v4.3",
  "version": "4.0.0",

  "codewhisperer": {
    "enabled": true,
    "auto_suggestions": true,
    "security_scans": true,
    "reference_tracking": true
  },

  "custom_rules": {
    "path": ".agent/core/RULES.md",
    "stop_conditions": ".agent/core/STOP.md"
  },

  "aws_integration": {
    "lambda": true,
    "dynamodb": true,
    "s3": true,
    "cloudformation": true
  },

  "commands": [
    "/ap", "/code", "/debug", "/plan", "/test", "/deploy",
    "/init", "/migrate", "/doc", "/generate"
  ],

  "token_budget": {
    "baseline": 1773,
    "per_skill": 1500
  }
}
