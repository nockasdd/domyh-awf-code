{
  "name": "DOMYH Awesome Code ",
  "version": v6.2.7,
  
  "activation": {
    "triggers": ["/ap", "/code", "/debug", "/plan", "/test", "/deploy", "/init", "/fix", "/refactor", "/review", "/status", "/migrate", "/git", "/doc", "/security", "/hsa"],
    "file_patterns": ["*.go", "*.py", "*.ts", "*.tsx", "*.vue"],
    "auto_detect": true
  },

  "skills": {
    "loading": "progressive",
    "max_active": 3,
    "cache_ttl": 3600,
    "preload": ["security"]
  },

  "token_budget": {
    "baseline": 1773,
    "per_skill": 1500,
    "max_peak": 6273
  },

  "features": {
    "semantic_selection": true,
    "lru_cache": true,
    "context_compression": false
  },

  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v1.0.0 Context Management",
      "command": "npx",
      "args": ["-y", "@nockdev/hsa@latest"],
      "auto_start": true,
      "env": {
        
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  }
}
