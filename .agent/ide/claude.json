{
  "name": "DOMYH Awesome Code v6.1.2",
  "version": "v6.1.2",
  
  "activation": {
    "triggers": ["/ap", "/code", "/debug", "/plan", "/test", "/deploy", "/init", "/migrate", "/doc", "/hsa"],
    "file_patterns": ["*.go", "*.py", "*.ts", "*.tsx", "*.vue"],
    "auto_detect": true
  },

  "skills": {
    "loading": "progressive",
    "max_active": 3,
    "cache_ttl": 3600,
    "preload": ["security"]
  },

  "token_budget": {
    "baseline": 1773,
    "per_skill": 1500,
    "max_peak": 6273
  },

  "features": {
    "semantic_selection": true,
    "lru_cache": true,
    "context_compression": false
  },

  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v5.0 Context Management",
      "command": "node",
      "args": [".agent/mcp/hsa-server/dist/index.js"],
      "auto_start": true
    }
  }
}
