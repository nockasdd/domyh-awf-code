{
  "name": "DOMYH Awesome Code",
  "version": "v6.4.10",
  "activation": {
    "triggers": [
      "/ap",
      "/code",
      "/debug",
      "/deploy",
      "/dev",
      "/doc",
      "/fix",
      "/git",
      "/hsa",
      "/init",
      "/migrate",
      "/plan",
      "/refactor",
      "/review",
      "/security",
      "/status",
      "/test"
    ],
    "file_patterns": [
      "*.go",
      "*.py",
      "*.ts",
      "*.tsx",
      "*.vue"
    ],
    "auto_detect": true
  },
  "skills": {
    "loading": "progressive",
    "max_active": 3,
    "cache_ttl": 3600,
    "preload": [
      "security"
    ]
  },
  "token_budget": {
    "baseline": 2200,
    "per_skill": 1500,
    "max_peak": 6700
  },
  "features": {
    "semantic_selection": true,
    "lru_cache": true,
    "context_compression": false
  },
  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v1.3.2 Context Management",
      "command": "npx",
      "args": [
        "-y",
        "@nockdev/hsa@1.2.9"
      ],
      "auto_start": true,
      "env": {
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  }
}