{
  "name": "DOMYH Agent v4.0",
  "version": "4.0.0",
  
  "activation": {
    "triggers": ["/ap", "/code", "/debug", "/plan", "/test", "/deploy", "/init", "/migrate", "/doc"],
    "file_patterns": ["*.go", "*.py", "*.ts", "*.tsx", "*.vue"],
    "auto_detect": true
  },

  "skills": {
    "loading": "progressive",
    "max_active": 3,
    "cache_ttl": 3600,
    "preload": ["security"]
  },

  "token_budget": {
    "baseline": 1773,
    "per_skill": 1500,
    "max_peak": 6273
  },

  "features": {
    "semantic_selection": true,
    "lru_cache": true,
    "context_compression": false
  }
}
