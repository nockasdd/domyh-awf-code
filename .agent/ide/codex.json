{
  "name": "codex",
  "displayName": "OpenAI Codex CLI",
  "description": "Configuration template for OpenAI Codex CLI integration",
  "version": "v6.4.2",
  "configFiles": [
    {
      "path": ".codex/.codex-rules.md",
      "type": "markdown",
      "description": "Main instructions file for Codex"
    },
    {
      "path": ".codex/config.json",
      "type": "json",
      "description": "Codex configuration settings"
    }
  ],
  "activation": {
    "triggers": [
      "/ap",
      "/code",
      "/debug",
      "/deploy",
      "/dev",
      "/doc",
      "/fix",
      "/git",
      "/hsa",
      "/init",
      "/plan",
      "/refactor",
      "/review",
      "/security",
      "/status",
      "/test"
    ],
    "auto_context": true
  },
  "features": {
    "customInstructions": true,
    "contextFiles": true,
    "skillLoading": true,
    "workflowSupport": true
  },
  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v1.3.2 Context Management",
      "command": "npx",
      "args": [
        "-y",
        "@nockdev/hsa@1.2.9"
      ],
      "auto_start": true,
      "env": {
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  },
  "documentation": "https://platform.openai.com/docs/codex"
}