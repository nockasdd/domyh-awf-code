{
  "name": "DOMYH Awesome Code",
  "version": "v6.2.2",
  "ide": "Tabnine",
  "value": "tabnine",

  "activation": {
    "triggers": ["/ap", "/code", "/debug", "/plan", "/test", "/fix"],
    "auto_context": true
  },

  "skills": {
    "loading": "progressive",
    "max_active": 3
  },

  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v1.0.0 Context Management",
      "command": "npx",
      "args": ["-y", "@nockdev/hsa@latest"],
      "auto_start": true,
      "env": {
        
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  },

  "config_files": {
    "guidelines": ".tabnine/guidelines/",
    "mcp": ".tabnine/mcp_servers.json",
    "mcp_note": "Enterprise: supports STDIO, HTTP, and SSE transports"
  }
}
