{
  "name": "DOMYH Awesome Code",
  "version": v6.2.5,
  "ide": "Zed Editor",
  "value": "zed",

  "activation": {
    "triggers": ["/ap", "/code", "/debug", "/plan", "/test", "/fix"],
    "auto_context": true
  },

  "skills": {
    "loading": "progressive",
    "max_active": 3
  },

  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v1.0.0 Context Management",
      "command": "npx",
      "args": ["-y", "@nockdev/hsa@latest"],
      "auto_start": true,
      "env": {
        
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  },

  "config_files": {
    "rules": ".rules",
    "mcp": "~/.config/zed/settings.json",
    "mcp_key": "context_servers",
    "mcp_note": "Zed uses 'context_servers' key with nested { command: { path, args, env }, settings: {} } format"
  }
}
