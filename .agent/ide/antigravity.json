{
  "name": "DOMYH Awesome Code",
  "version": "v6.3.9",
  "ide": "Antigravity",
  "value": "antigravity",
  "activation": {
    "triggers": [
      "/ap",
      "/code",
      "/debug",
      "/deploy",
      "/dev",
      "/doc",
      "/fix",
      "/git",
      "/hsa",
      "/init",
      "/perf",
      "/plan",
      "/recap",
      "/refactor",
      "/review",
      "/scaffold",
      "/security",
      "/status",
      "/test",
      "/think"
    ],
    "workspace_detection": true
  },
  "skills": {
    "loading": "progressive",
    "max_active": 5,
    "cache_enabled": true
  },
  "token_budget": {
    "baseline": 2200,
    "per_skill": 1500,
    "max_peak": 9700
  },
  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v1.3.2 Context Management - Intelligent context retrieval",
      "command": "npx",
      "args": [
        "-y",
        "@nockdev/hsa@1.2.9"
      ],
      "auto_start": true,
      "env": {
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  },
  "config_files": {
    "instructions": "GEMINI.md",
    "mcp": "~/.gemini/antigravity/mcp_config.json"
  },
  "hsa": {
    "enabled": true,
    "auto_detect_stack": true,
    "_note": "Tools auto-discovered via MCP tools/list RPC — see hsa-engine-ts/src/server/tool-definitions.ts for source of truth"
  }
}