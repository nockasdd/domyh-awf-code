{
  "name": "DOMYH Awesome Code v6.1.2",
  "version": "v6.1.2",
  
  "cursor": {
    "agent_mode": true,
    "composer_integration": true
  },

  "activation": {
    "triggers": ["@domyh", "/ap", "/code", "/debug", "/init", "/migrate", "/hsa"],
    "auto_context": true
  },

  "skills": {
    "loading": "progressive",
    "max_active": 3
  },

  "token_budget": {
    "baseline": 1773,
    "per_skill": 1500
  },

  "rules": {
    "include_path": "../core/RULES.md",
    "stop_path": "../core/STOP.md"
  },

  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v5.0 Context Management",
      "command": "node",
      "args": [".agent/mcp/hsa-server/dist/index.js"],
      "auto_start": true
    }
  }
}
