{
  "name": "DOMYH Awesome Code",
  "version": "v6.5.0",
  "cursor": {
    "agent_mode": true,
    "composer_integration": true
  },
  "activation": {
    "triggers": [
      "@domyh",
      "/ap",
      "/code",
      "/debug",
      "/deploy",
      "/dev",
      "/doc",
      "/fix",
      "/git",
      "/hsa",
      "/init",
      "/migrate",
      "/plan",
      "/refactor",
      "/review",
      "/security",
      "/status",
      "/test"
    ],
    "auto_context": true
  },
  "skills": {
    "loading": "progressive",
    "max_active": 3
  },
  "token_budget": {
    "baseline": 2200,
    "per_skill": 1500,
    "max_peak": 6700
  },
  "rules": {
    "sacred_rules": "../rules/SACRED_RULES.xml"
  },
  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v1.3.2 Context Management",
      "command": "npx",
      "args": [
        "-y",
        "@nockdev/hsa@1.2.9"
      ],
      "auto_start": true,
      "env": {
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  }
}