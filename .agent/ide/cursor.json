{
  "name": "DOMYH Awesome Code ",
  "version": "v6.2.2",
  
  "cursor": {
    "agent_mode": true,
    "composer_integration": true
  },

  "activation": {
    "triggers": ["@domyh", "/ap", "/code", "/debug", "/plan", "/test", "/init", "/fix", "/migrate", "/hsa"],
    "auto_context": true
  },

  "skills": {
    "loading": "progressive",
    "max_active": 3
  },

  "token_budget": {
    "baseline": 1773,
    "per_skill": 1500
  },

  "rules": {
    "include_path": "../core/RULES.md",
    "stop_path": "../core/STOP.md"
  },

  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v1.0.0 Context Management",
      "command": "npx",
      "args": ["-y", "@nockdev/hsa@latest"],
      "auto_start": true,
      "env": {
        
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  }
}
