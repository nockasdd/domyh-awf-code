{
  "name": "DOMYH Awesome Code",
  "version": "v6.5.0",
  "ide": "Augment Code",
  "value": "augment",
  "activation": {
    "triggers": [
      "/ap",
      "/code",
      "/debug",
      "/deploy",
      "/dev",
      "/doc",
      "/fix",
      "/git",
      "/hsa",
      "/init",
      "/plan",
      "/refactor",
      "/review",
      "/security",
      "/status",
      "/test"
    ],
    "auto_context": true
  },
  "skills": {
    "loading": "progressive",
    "max_active": 3
  },
  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v1.3.2 Context Management",
      "command": "npx",
      "args": [
        "-y",
        "@nockdev/hsa@1.2.9"
      ],
      "auto_start": true,
      "env": {
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  },
  "config_files": {
    "settings": "~/.augment/settings.json",
    "mcp_key": "mcp",
    "mcp_note": "Augment uses 'mcp' key. Context Engine integration"
  }
}