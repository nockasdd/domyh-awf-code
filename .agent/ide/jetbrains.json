{
  "name": "DOMYH Awesome Code",
  "version": "v6.6.7",
  "ide": "JetBrains AI (Junie)",
  "value": "jetbrains",
  "activation": {
    "triggers": [
      "/ap",
      "/code",
      "/debug",
      "/deploy",
      "/dev",
      "/doc",
      "/fix",
      "/git",
      "/hsa",
      "/init",
      "/plan",
      "/refactor",
      "/review",
      "/security",
      "/status",
      "/test"
    ],
    "auto_context": true
  },
  "skills": {
    "loading": "progressive",
    "max_active": 3
  },
  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v1.3.2 Context Management",
      "command": "npx",
      "args": [
        "-y",
        "@nockdev/hsa@1.2.9"
      ],
      "auto_start": true,
      "env": {
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  },
  "config_files": {
    "guidelines": ".junie/guidelines.md",
    "mcp": ".junie/mcp/mcp.json",
    "mcp_note": "filename is mcp.json, NOT servers.json"
  }
}