{
  "name": "DOMYH Awesome Code",
  "version": "v6.5.0",
  "gemini": {
    "model_preference": "gemini-2.0-flash",
    "context_window": 1000000,
    "thinking_budget": 32768
  },
  "activation": {
    "triggers": [
      "/ap",
      "/code",
      "/debug",
      "/deploy",
      "/dev",
      "/doc",
      "/fix",
      "/git",
      "/hsa",
      "/init",
      "/migrate",
      "/plan",
      "/refactor",
      "/review",
      "/security",
      "/status",
      "/test"
    ],
    "workspace_detection": true
  },
  "skills": {
    "loading": "progressive",
    "max_active": 5,
    "cache_enabled": true
  },
  "token_budget": {
    "baseline": 2200,
    "per_skill": 1500,
    "max_peak": 9700
  },
  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v1.3.2 Context Management - Intelligent context retrieval",
      "command": "npx",
      "args": [
        "-y",
        "@nockdev/hsa@1.2.9"
      ],
      "auto_start": true,
      "env": {
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  },
  "hsa": {
    "enabled": true,
    "auto_detect_stack": true,
    "_note": "Tools auto-discovered via MCP tools/list RPC — see hsa-engine-ts/src/server/tool-definitions.ts for source of truth"
  }
}