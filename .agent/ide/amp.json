{
  "name": "DOMYH Awesome Code",
  "version": v6.2.4,
  "ide": "Amp AI",
  "value": "amp",

  "activation": {
    "triggers": ["/ap", "/code", "/debug", "/plan", "/test", "/init", "/fix", "/hsa"],
    "auto_context": true
  },

  "skills": {
    "loading": "progressive",
    "max_active": 3
  },

  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v1.0.0 Context Management",
      "command": "npx",
      "args": ["-y", "@nockdev/hsa@latest"],
      "auto_start": true,
      "env": {
        
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  },

  "config_files": {
    "instructions": "AGENTS.md",
    "mcp": ".vscode/mcp.json",
    "mcp_note": "Amp shares VS Code MCP format"
  }
}
