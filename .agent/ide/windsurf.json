{
  "name": "DOMYH Awesome Code ",
  "version": "6.2.2",
  
  "windsurf": {
    "cascade_enabled": true,
    "flows_enabled": true
  },

  "activation": {
    "triggers": ["@domyh", "/ap", "/code", "/debug", "/plan", "/test", "/fix"],
    "auto_context": true
  },

  "skills": {
    "loading": "progressive",
    "max_active": 3
  },

  "token_budget": {
    "baseline": 1500,
    "per_skill": 1000
  },

  "config_files": {
    "rules": ".windsurfrules"
  },

  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v1.0.0 Context Management",
      "command": "npx",
      "args": ["-y", "@nockdev/hsa@latest"],
      "auto_start": true,
      "env": {
        
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  },

  "session_engine": {
    "enabled": true,
    "version": "2.0.0",
    "auto_detect_preferences": true,
    "config_file": ".windsurfrules",
    "context_injection": {
      "enabled": true,
      "format": "plain"
    },
    "cross_ide_sync": {
      "enabled": true,
      "targets": ["claude", "cursor", "gemini"]
    }
  }
}
