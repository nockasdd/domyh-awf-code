{
  "name": "DOMYH Awesome Code",
  "version": "v6.6.7",
  "windsurf": {
    "cascade_enabled": true,
    "flows_enabled": true
  },
  "activation": {
    "triggers": [
      "@domyh",
      "/ap",
      "/code",
      "/debug",
      "/deploy",
      "/dev",
      "/doc",
      "/fix",
      "/git",
      "/hsa",
      "/init",
      "/plan",
      "/refactor",
      "/review",
      "/security",
      "/status",
      "/test"
    ],
    "auto_context": true
  },
  "skills": {
    "loading": "progressive",
    "max_active": 3
  },
  "token_budget": {
    "baseline": 2200,
    "per_skill": 1500,
    "max_peak": 6700
  },
  "config_files": {
    "rules": ".windsurfrules"
  },
  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v1.3.2 Context Management",
      "command": "npx",
      "args": [
        "-y",
        "@nockdev/hsa@1.2.9"
      ],
      "auto_start": true,
      "env": {
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  },
  "session_engine": {
    "enabled": true,
    "version": "v6.6.7",
    "auto_detect_preferences": true,
    "config_file": ".windsurfrules",
    "context_injection": {
      "enabled": true,
      "format": "plain"
    },
    "cross_ide_sync": {
      "enabled": true,
      "targets": [
        "claude",
        "cursor",
        "gemini"
      ]
    }
  }
}