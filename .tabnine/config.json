{
  "name": "DOMYH Awesome Code v4.3",
  "version": "4.0.0",

  "tabnine": {
    "privacy": "all_code_stays_local",
    "code_completion": true,
    "whole_line_completion": true
  },

  "rules": {
    "path": ".agent/core/RULES.md",
    "stop_conditions": ".agent/core/STOP.md"
  },

  "commands": [
    "/ap", "/code", "/debug", "/plan", "/test", "/deploy",
    "/init", "/migrate", "/doc", "/generate", "/perf", "/upgrade"
  ],

  "token_budget": {
    "baseline": 1773,
    "per_skill": 1500
  }
}
