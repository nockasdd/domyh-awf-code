{
    "hooks": {
        "PostToolUse": [
            {
                "type": "command",
                "matcher": "editFiles|createFile|Write|Edit|MultiEdit|write_to_file|replace_file_content|multi_replace_file_content",
                "command": ".github/hooks/scripts/format-changed.sh",
                "windows": "powershell -ExecutionPolicy Bypass -File .github\\hooks\\scripts\\format-changed.ps1",
                "timeout": 30
            }
        ]
    }
}