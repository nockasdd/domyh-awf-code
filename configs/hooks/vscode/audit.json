{
    "hooks": {
        "PreToolUse": [
            {
                "type": "command",
                "command": ".github/hooks/scripts/audit-log.sh",
                "env": {
                    "AUDIT_LOG": ".github/hooks/audit.log"
                },
                "timeout": 5
            }
        ],
        "Stop": [
            {
                "type": "command",
                "command": ".github/hooks/scripts/session-persist.sh",
                "windows": "powershell -ExecutionPolicy Bypass -File .github\\hooks\\scripts\\session-persist.ps1",
                "timeout": 10
            }
        ],
        "PreCompact": [
            {
                "type": "command",
                "command": ".github/hooks/scripts/pre-compact-snapshot.sh",
                "windows": "powershell -ExecutionPolicy Bypass -File .github\\hooks\\scripts\\pre-compact-snapshot.ps1",
                "timeout": 5
            }
        ]
    }
}