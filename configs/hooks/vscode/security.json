{
    "hooks": {
        "PreToolUse": [
            {
                "type": "command",
                "matcher": "runTerminalCommand|Bash|execute|run_command",
                "command": ".github/hooks/scripts/safe-guard.sh",
                "windows": "powershell -ExecutionPolicy Bypass -File .github\\hooks\\scripts\\safe-guard.ps1",
                "timeout": 10
            },
            {
                "type": "command",
                "matcher": "editFiles|createFile|Write|Edit|MultiEdit|write_to_file|replace_file_content|multi_replace_file_content",
                "command": ".github/hooks/scripts/path-guard.sh",
                "windows": "powershell -ExecutionPolicy Bypass -File .github\\hooks\\scripts\\path-guard.ps1",
                "timeout": 5
            }
        ]
    }
}