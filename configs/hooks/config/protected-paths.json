{
    "protected_paths": [
        {
            "pattern": "\\.env$|\\.env\\.",
            "action": "deny",
            "reason": "Environment files are read-only — edit manually"
        },
        {
            "pattern": "\\.git/",
            "action": "deny",
            "reason": "Git internals are protected"
        },
        {
            "pattern": "package-lock\\.json|yarn\\.lock|pnpm-lock\\.yaml|bun\\.lockb",
            "action": "deny",
            "reason": "Lock files should not be edited directly — run install commands"
        },
        {
            "pattern": "\\.ssh/|id_rsa|id_ed25519",
            "action": "deny",
            "reason": "SSH keys are protected"
        },
        {
            "pattern": "\\.claude/settings\\.json|\\.cursor/settings\\.json",
            "action": "ask",
            "reason": "IDE settings modification requires confirmation"
        },
        {
            "pattern": "\\.github/hooks/",
            "action": "deny",
            "reason": "Hook scripts are protected — edit source configs instead"
        }
    ]
}