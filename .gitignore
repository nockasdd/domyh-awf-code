# Session rules may contain sensitive preferences
.agent/memory/session_rules.json
.agent/memory/session_rules.*.json

# ── HSA runtime cache ────────────────────────────────────────
.hsa_cache/
.agent/hsa/

# ── Game engine artifacts ────────────────────────────────────
# Unity: editor-generated. .meta files MUST stay tracked — they carry the GUIDs
# that scene/prefab references resolve against.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.csproj
*.sln

# Unreal
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Godot: exclude CONTENTS, not the directory — a bare `.godot/` exclusion with a
# negation is inert. global_script_class_cache.cfg backs every `class_name`
# declaration; losing it breaks all cross-referencing scripts on a fresh clone,
# yet `godot --headless --quit` still exits 0 so CI cannot catch it.
**/.godot/*
!**/.godot/global_script_class_cache.cfg

# ── Environment ──────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Misc ─────────────────────────────────────────────────────
*.tgz
*.tsbuildinfo
coverage/
tmp/
temp/

# ── Private Skills (not shared publicly) ─────────────────────
.agent/private/
# ── FLOW.md ──────────────────────────────────────────────
FLOW(Chi-dung-de-lay-thong-tin).md

# ── scripts (track bump-version, ignore local-only) ───────
scripts/local/

# ── DOMYH local runtime (audits, session data) ───────────
.domyh/
.docs/
# — HSA bridge bearer tokens (written by the bridge at startup) —
mcp-bridge-plugins/*/hsa_bridge_token
mcp-bridge-plugins/unity-bridge/Library/
